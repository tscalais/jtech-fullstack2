# Example Environment Variables
# Copie este arquivo para .env.development ou .env.production e ajuste os valores

# ==============================================
# API Configuration
# ==============================================

# URL base da API (Backend Spring Boot)
# Desenvolvimento: http://localhost:8080
# Produção: https://api.seu-dominio.com
VITE_API_BASE_URL=http://localhost:8080

# ==============================================
# Debug & Development
# ==============================================

# Habilitar logs de debug (true/false)
# VITE_ENABLE_DEBUG=false

# ==============================================
# Feature Flags (opcional)
# ==============================================

# Habilitar funcionalidades experimentais
# VITE_ENABLE_EXPERIMENTAL_FEATURES=false
